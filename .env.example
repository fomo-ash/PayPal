

# ── PayPal (developer.paypal.com → Apps & Credentials → Sandbox) ──────────────
PAYPAL_ENV=sandbox                      # sandbox | live (we only use sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=                      # from the app's Webhooks section; needed to verify signatures
PAYPAL_RETURN_URL=http://localhost:3000/fund/return
PAYPAL_CANCEL_URL=http://localhost:3000/fund/cancel
PAYPAL_LOGIN_REDIRECT_URI=http://localhost:3000/auth/callback

# Sandbox test accounts (Testing Tools → Sandbox Accounts). Used by scripts/sandbox_spike.py
SANDBOX_WORKER_EMAIL=                   # a sandbox PERSONAL account that receives the payout

# ── Frontend (exposed to the browser: client ID only, never the secret) ──────
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── LLM (free tiers) ───────────────────

LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
JUDGE_MODEL=openai/gpt-oss-120b          # cheating review + spec check
DRAFT_MODEL=llama-3.1-8b-instant         # cheap drafts (fresh-input generators)


LLM_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=gemini-flash-latest   

# ── Sandbox runner ────────────────────────────────────────────────────────────
SANDBOX_BACKEND=e2b                     # e2b | local (local = no isolation, dev only)
E2B_API_KEY=

# ── API (dev) ──
DEV_AUTH=true                           # X-User-Id header login until Log in with PayPal; refused with live
BLOB_DIR=data/blobs                     # where suites and submissions are stored (git-ignored)
SANDBOX_TEST_TIMEOUT_MS=2000            # per test case
SANDBOX_MEMORY_MB=512

# ── Data ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://verdict:verdict@localhost:5432/verdict
REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=verdict-dev

# ── Business rules ────────────────────────────────────────────────────────────
PLATFORM_FEE_BPS=500                    # 5.00%
MAX_JOB_DEADLINE_HOURS=48               # stay inside PayPal's 3-day authorization honor period
FRESH_INPUT_COUNT=200
NEW_BUYER_PAYOUT_DELAY_HOURS=0          # set >0 in production to reduce chargeback risk

# ── Receipts ──────────────────────────────────────────────────────────────────
RECEIPT_SIGNING_KEY_B64=                # Ed25519 private key, base64; generate with scripts (Phase 4)

# ── Observability (optional) ─────────────────────────────────────────────────
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
